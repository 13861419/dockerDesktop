{
  "name": "@13861419/docker-manager",
  "version": "0.2.0",
  "description": "Docker 管理面板（支持 Windows / Ubuntu 24 / CentOS 7+，类似 1Panel）",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/13861419/dockerDesktop.git"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "regression:files-events": "node scripts/regression-files-events.js",
    "regression:databases": "node scripts/regression-databases.js",
    "regression:appstore": "node scripts/regression-appstore.js",
    "regression:images": "node scripts/regression-images.js",
    "regression:overview": "node scripts/regression-overview.js",
    "regression:volumes": "node scripts/regression-volumes.js",
    "regression:hub": "node scripts/regression-hub.js",
    "regression:containers": "node scripts/regression-containers.js",
    "regression:compose": "node scripts/regression-compose.js",
    "regression:networks": "node scripts/regression-networks.js",
    "regression:sites": "node scripts/regression-sites.js",
    "regression:settings": "node scripts/regression-settings.js",
    "regression:storage": "node scripts/regression-storage.js",
    "regression:backups": "node scripts/regression-backups.js",
    "regression:cloudbackup": "node scripts/regression-cloudbackup.js",
    "regression:engines": "node scripts/regression-engines.js",
    "regression:firewall": "node scripts/regression-firewall.js",
    "regression:tasks": "node scripts/regression-tasks.js",
    "regression:operationlogs": "node scripts/regression-operationlogs.js",
    "regression:build": "node scripts/regression-build.js",
    "regression:hostfiles": "node scripts/regression-hostfiles.js",
    "regression:hostterminal": "node scripts/regression-hostterminal.js",
    "regression:containerdetail": "node scripts/regression-containerdetail.js",
    "regression:imagedetail": "node scripts/regression-imagedetail.js",
    "regression:notifications": "node scripts/regression-notifications.js",
    "regression:all": "node scripts/run-regression-all.js",
    "regression:deep": "node scripts/regression-all-pages.js",
    "test:server": "npm run test --workspace server",
    "test:server:unit": "npm run test:unit --workspace server",
    "test:server:api": "npm run test:api --workspace server",
    "test:e2e": "node scripts/regression-all-pages.js",
    "test:e2e:deep": "node scripts/e2e-functional-test.js",
    "test:e2e:functional": "node scripts/e2e-functional-test.js",
    "mock:hub-search": "node scripts/mock-hub-search.js",
    "package": "node packaging/build-release.js",
    "package:installer": "node packaging/build-installer.js",
    "package:deb": "bash packaging/linux/build-deb.sh",
    "package:rpm": "bash packaging/linux/build-rpm.sh"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "playwright-core": "^1.55.0"
  },
  "engines": {
    "node": ">=22"
  }
}
